#!/bin/bash
set -euo pipefail
SCRIPT="$0"
while [ -L "$SCRIPT" ]; do
  SCRIPT_DIR="$(cd "$(dirname "$SCRIPT")" && pwd -P)"
  TARGET="$(/usr/bin/readlink "$SCRIPT")"
  case "$TARGET" in
    /*) SCRIPT="$TARGET" ;;
    *) SCRIPT="$SCRIPT_DIR/$TARGET" ;;
  esac
done
ROOT="$(cd "$(dirname "$SCRIPT")/.." && pwd -P)"
NODE_BIN="${ORCA_WATCHDOG_NODE:-$(command -v node || true)}"
[ -n "$NODE_BIN" ] || { echo "error: node not found; install Node 22 or 24" >&2; exit 1; }
exec "$NODE_BIN" "$ROOT/bin/orca-limit-watchdog.mjs" "$@"
